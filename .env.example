# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/thriftchef

# --- Meal planner ----------------------------------------------------------
# Meal plans are built locally by a deterministic bounded search over the Aldi
# catalogue. There is no model, no API key and no external call in the request
# path. Every value below caps work, never quality — leave them alone unless
# you are deliberately trading breadth for speed.
#
# Products handed to the planner, balanced across food groups. 20-200.
MEAL_PLAN_MAX_PRODUCTS=80
# Complete weeks validated and priced before a winner is chosen. 4-64.
MEAL_PLAN_CANDIDATE_LIMIT=24
# Partial states kept between search stages. 8-128.
MEAL_PLAN_BEAM_WIDTH=32
# Distinct ingredient fillings enumerated per recipe template. 1-12.
MEAL_PLAN_MAX_RECIPE_VARIANTS=6
# Wall-clock ceiling for one plan, checked between stages. 250-5000.
# A normal week finishes in tens of milliseconds; reaching this means trouble.
MEAL_PLAN_ENGINE_TIMEOUT_MS=1500

# --- Meal plan route rate limiting ------------------------------------------------
MEAL_PLAN_RATE_LIMIT_WINDOW_MS=60000
MEAL_PLAN_RATE_LIMIT_MAX=10

# --- Aldi catalogue crawl --------------------------------------------------
ALDI_STORE_ID=belper-de56-1ar
ALDI_EXPECTED_STORE_TEXT=DE56 1AR
# false opens a visible browser so the store can be selected by hand.
ALDI_HEADLESS=false
# Optional. Caps products per category for a fast, bounded crawl.
# ALDI_MAX_PRODUCTS_PER_CATEGORY=20

# --- Optional tuning -------------------------------------------------------
CATALOGUE_STALE_AFTER_HOURS=72
MEAL_PLAN_DEFAULT_SNACKS=false
LOG_LEVEL=info
