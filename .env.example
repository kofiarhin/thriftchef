# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core ------------------------------------------------------------------
NODE_ENV=development
# Local only. Heroku supplies PORT at runtime — never set it there.
PORT=5000
# Exactly one origin in production; CORS is unrestricted only in development.
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/thriftchef

# --- Client build ----------------------------------------------------------
# Origin of the API, with no trailing slash and no /api suffix — the client
# appends /api/... itself. Leave empty locally: the Vite dev server proxies /api.
VITE_API_BASE_URL=

# --- Meal planner ----------------------------------------------------------
# Meal plans are built locally by a deterministic bounded search over the Aldi
# catalogue. There is no model, no API key and no external call in the request
# path. Every value below caps work, never quality — leave them alone unless
# you are deliberately trading breadth for speed.
#
# Products handed to the planner, balanced across food groups. 20-200.
MEAL_PLAN_MAX_PRODUCTS=80
# Complete weeks validated and priced before a winner is chosen. 4-64.
MEAL_PLAN_CANDIDATE_LIMIT=24
# Partial states kept between search stages. 8-128.
MEAL_PLAN_BEAM_WIDTH=32
# Distinct ingredient fillings enumerated per recipe template. 1-12.
MEAL_PLAN_MAX_RECIPE_VARIANTS=6
# Wall-clock ceiling for one plan, checked between stages. 250-5000.
# A normal week finishes in tens of milliseconds; reaching this means trouble.
MEAL_PLAN_ENGINE_TIMEOUT_MS=1500

# --- Catalogue ownership ---------------------------------------------------
# The retailer a request falls back to when it names none. Every catalogue
# query is scoped by retailer and store; this only supplies the default.
DEFAULT_RETAILER_SLUG=aldi-uk
# Which collection the catalogue is read from: "legacy" (product fields) or
# "offers" (store-scoped ProductOffer). Move to "offers" only after
# `npm run catalogue:backfill -- --compare` reports both paths agree.
# Rolling back is this variable, not a database restore.
CATALOGUE_READ_SOURCE=legacy

# --- Anonymous plan retention ----------------------------------------------
# How long a generated plan stays reopenable. Enforced by a MongoDB TTL index.
PLAN_RETENTION_DAYS=30

# --- Operational throttling -------------------------------------------------
# NOT a user-facing quota. Generation is free, anonymous and unmetered; these
# limits exist to stop automated abuse and are set far above anything a person
# planning their week could reach. Replacement has its own, larger budget
# because swapping is the most repeated action in the product.
THROTTLE_WINDOW_MS=60000
THROTTLE_GENERATE_PER_WINDOW=60
THROTTLE_REPLACE_PER_WINDOW=120
THROTTLE_SEARCH_PER_WINDOW=240

# Superseded by THROTTLE_* above; kept so existing deployments still parse.
MEAL_PLAN_RATE_LIMIT_WINDOW_MS=60000
MEAL_PLAN_RATE_LIMIT_MAX=10

# --- Admin -----------------------------------------------------------------
# Read-only catalogue administration. Refused entirely when NODE_ENV=production,
# regardless of this value, until an authentication mechanism is approved.
ADMIN_ENABLED=false

# --- Aldi catalogue crawl --------------------------------------------------
ALDI_STORE_ID=belper-de56-1ar
ALDI_EXPECTED_STORE_TEXT=DE56 1AR
# false opens a visible browser so the store can be selected by hand.
ALDI_HEADLESS=false
# Optional. Caps products per category for a fast, bounded crawl.
# ALDI_MAX_PRODUCTS_PER_CATEGORY=20

# --- Tesco catalogue crawl (development integration) -----------------------
# Tesco is registered but its retailer record is `development`, so it is not
# selectable by anyone and no plan can be built from it. Populating it is a
# separate, authorised operation — see the README.
#
# There is deliberately no default scope. A crawl must say which catalogue it
# is collecting, because a guess writes one shop's prices under another shop's
# name and nothing downstream can tell afterwards.
#
# The store/scope id, matching a seeded RetailStore.externalStoreId.
# The bootstrap seeds `tesco-online-gb` unless this is set.
TESCO_STORE_ID=
# Establishes a fulfilment location when the scope needs one. Only the outward
# area (e.g. "CV1") is ever written to a log; the full value never is.
TESCO_POSTCODE=
# What the page must show for the session to count as verified. Without a
# match, a store-scoped crawl writes nothing at all.
TESCO_EXPECTED_LOCATION_TEXT=
# delivery | collection
TESCO_FULFILMENT_MODE=delivery
# false opens a visible browser so the fulfilment location can be confirmed by
# hand. Keep it false until the location step has been verified once.
TESCO_HEADLESS=false
# Optional. Caps products per category, which makes the run `bounded` and
# therefore permanently ineligible to retire a product.
TESCO_MAX_PRODUCTS_PER_CATEGORY=20

# --- Optional tuning -------------------------------------------------------
CATALOGUE_STALE_AFTER_HOURS=72
MEAL_PLAN_DEFAULT_SNACKS=false
LOG_LEVEL=info
