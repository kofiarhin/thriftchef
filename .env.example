# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/thriftchef

# --- Meal plan generator ---------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# --- AI route rate limiting ------------------------------------------------
MEAL_PLAN_RATE_LIMIT_WINDOW_MS=60000
MEAL_PLAN_RATE_LIMIT_MAX=10

# --- Aldi catalogue crawl --------------------------------------------------
ALDI_STORE_ID=belper-de56-1ar
ALDI_EXPECTED_STORE_TEXT=DE56 1AR
# false opens a visible browser so the store can be selected by hand.
ALDI_HEADLESS=false
# Optional. Caps products per category for a fast, bounded crawl.
# ALDI_MAX_PRODUCTS_PER_CATEGORY=20

# --- Optional tuning -------------------------------------------------------
CATALOGUE_STALE_AFTER_HOURS=72
MEAL_PLAN_MAX_CONTEXT_PRODUCTS=120
MEAL_PLAN_DEFAULT_SNACKS=false
LOG_LEVEL=info
