{
  "name": "thriftchef",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "preview": "vite preview",
    "start": "tsx server/server.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:client",
    "test:unit": "tsx --test \"server/**/*.test.ts\"",
    "test:client": "vitest run",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "benchmark:planner": "tsx server/mealPlanning/plannerBenchmark.ts",
    "aldi:crawl": "tsx server/catalogue/aldi/runAldiCrawl.ts",
    "catalogue:inspect": "tsx scripts/inspect-catalogue.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "cors": "^2.8.6",
    "crawlee": "^3.17.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.1",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
